{
  "appId": "com.suaempresa.pdvorcamento",
  "productName": "PDV Orcamento Balcao",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "electron/assets",
      "to": "assets",
      "filter": ["**/*"]
    },
    {
      "from": "electron/print.ps1",
      "to": "print.ps1"
    },
    {
      "from": "electron/printer-status.ps1",
      "to": "printer-status.ps1"
    }
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "electron/assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PDV Orcamento Balcao"
  },
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**"
  ]
}
